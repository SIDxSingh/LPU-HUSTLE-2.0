# ========================================================
# LpuHustle - Environment Configuration Example
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development
SERVER_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# Database (Leave empty for automatic dev in-memory fallback, or paste Atlas URI)
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/lpuhustle?retryWrites=true&w=majority
MONGO_URI=

# JWT Authentication
JWT_SECRET=lpuhustle_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=30d

# Cloudinary Storage (Optional for local dev, required for cloud production)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
